# ============================================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT (ECO-MENTORAT)
# Dupliquer ce fichier en '.env' et renseigner les vraies valeurs
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB (Local ou MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/eco_mentorat

# Clé secrète JWT (Générer une clé aléatoire forte en production)
JWT_SECRET=votre_cle_secrete_jwt_robuste_minimum_64_caracteres_aleatoires

# Durée de validité du token
JWT_EXPIRES_IN=7d

# URL du client frontend pour CORS
CLIENT_URL=http://localhost:5173

# ============================================================
# META MODEL API — Muse Spark (Traduction temps-réel)
# Obtenir les clés sur : https://api.meta.ai
# ============================================================

# URL de base de l'API Meta Model (ne pas modifier sauf si Meta change l'URL)
META_MODEL_API_URL=https://api.meta.ai/v1

# Clé d'API principale Meta (confidentielle — jamais commiter la vraie valeur)
META_API_KEY=

# Modèle Muse Spark utilisé pour la traduction et la modération
MUSE_SPARK_MODEL=muse-spark-1.3

# URL spécifique pour la transcription vocale Muse Voice
MUSE_TRANSCRIBE_URL=

# URL spécifique pour la génération d'images Muse Wonder
MUSE_WONDER_URL=

# Modèle Wonder pour la génération d'images (vignettes challenges / portfolios)
MUSE_WONDER_MODEL=muse-wonder-1.0

# ============================================================
# BASETEN (Open-weights fallback — bonus $10k hackathon)
# Fallback si Meta API est indisponible ou quota épuisé
# ============================================================

# URL du déploiement Baseten muse-spark-open-1026
BASETEN_API_URL=

# Clé d'API Baseten
BASETEN_API_KEY=
