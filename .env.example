# ============================================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT (ECO-MENTORAT)
# Dupliquer ce fichier en '.env' et renseigner les vraies valeurs
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB (Local ou MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/eco_mentorat

# Clé secrète JWT (Générer une clé aléatoire forte en production)
JWT_SECRET=votre_cle_secrete_jwt_robuste_minimum_64_caracteres_aleatoires

# Durée de validité du token
JWT_EXPIRES_IN=7d

# URL du client frontend pour CORS
CLIENT_URL=http://localhost:5173
